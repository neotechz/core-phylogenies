nextflow_process {

    name "Test Process FILTER_BY_NUCLEOTIDE_DIVERSITY"
    script "modules/filter-by-nucleotide-diversity.nf"
    process "FILTER_BY_NUCLEOTIDE_DIVERSITY"
    profile "local"

    test("Returns TRUE if above or equal cutoff") {

        when {
            params {
                filter_by_nucleotide_diversity_cutoff = 0.1
            }
            process {
                """
                input[0] = Channel.of(["prorocentrum-spp",
                    "${projectDir}/tests/data/prorocentrum-spp-formatted/28S.fasta",
                    "${params.filter_by_nucleotide_diversity_cutoff}",
                    "\${params.container_base}",
                    null])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out[0][0][0] == "prorocentrum-spp" },
                { assert process.out[0][0][1] == "TRUE" }
            )
        }

    }

    test("Returns FALSE if below cutoff") {

        when {
            params {
                filter_by_nucleotide_diversity_cutoff = 0.99
            }
            process {
                """
                input[0] = Channel.of(["prorocentrum-spp",
                    "${projectDir}/tests/data/prorocentrum-spp-formatted/28S.fasta",
                    "${params.filter_by_nucleotide_diversity_cutoff}",
                    "\${params.container_base}",
                    null])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out[0][0][0] == "prorocentrum-spp" },
                { assert process.out[0][0][1] == "FALSE" }
            )
        }
        
    }

}